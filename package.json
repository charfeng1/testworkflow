{
	"name": "notifai",
	"version": "0.1.0",
	"type": "module",
	"description": "Persistent personal agent platform — NanoClaw without containers",
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"dev": "tsx src/index.ts",
		"notifai": "tsx src/index.ts",
		"lint": "biome check src/ tests/",
		"lint:fix": "biome check --write src/ tests/",
		"typecheck": "tsc -p tsconfig.check.json",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.2.71"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@types/node": "^22.15.0",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0",
		"vitest": "^4.0.18"
	}
}
